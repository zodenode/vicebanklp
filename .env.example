# Public site base path for GitHub Pages (repo name)
VITE_BASE=/vicebanklp/

# Concierge WhatsApp (E.164 without +), e.g. 447700900123
VITE_WHATSAPP_NUMBER=

# Stripe Payment Link URL for membership checkout
VITE_STRIPE_PAYMENT_LINK=

# Airtable (optional — waitlist + booking requests)
# Prefer a personal access token scoped to this base. For production,
# proxy writes through a serverless function instead of exposing the token.
VITE_AIRTABLE_API_KEY=
VITE_AIRTABLE_BASE_ID=
VITE_AIRTABLE_WAITLIST_TABLE=Waitlist
VITE_AIRTABLE_BOOKINGS_TABLE=Bookings
